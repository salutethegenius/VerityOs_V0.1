# VerityOS local development. Names and documentation only — never commit secrets.

# Postgres (Compose maps host 5433 to avoid clashing with a local 5432)
DATABASE_URL=postgres://verityos:verityos@localhost:5433/verityos_audit

# Persistent document/blob root (Knowledge). Mount this to durable storage.
VERITY_DATA_DIR=./data

# Audit Kernel
AUDIT_KERNEL_VERSION=0.2.0
AUDIT_MERKLE_INTERVAL=10

# Core API
PORT=8080
CORS_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_SECRET=change-me-in-deployment

# Embedding provider for Knowledge. `mock` is the CI/sovereign default.
# openai-compatible may point at a local runtime; it is not an architectural dependency.
VERITY_EMBEDDING_PROVIDER=mock

# Model provider keys — set in the live environment only. Leave unset for mock routing.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
