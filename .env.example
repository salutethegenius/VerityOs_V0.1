# VerityOS local development. Names and documentation only — never commit secrets.

# Postgres (Compose maps host 5433 to avoid clashing with a local 5432)
DATABASE_URL=postgres://verityos:verityos@localhost:5433/verityos_audit

# Persistent document/blob root (Knowledge, Phase 6). Mount this to durable storage.
VERITY_DATA_DIR=./data

# Audit Kernel
AUDIT_KERNEL_VERSION=0.2.0
AUDIT_MERKLE_INTERVAL=10

# Reserved for later phases (do not set dummy production values here)
# AUTH secrets, Slack, Meta, model provider keys, and signing keys belong in the
# live environment of the service that uses them — not in git.
