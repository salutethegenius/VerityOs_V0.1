# VerityOS local / demo environment. Names and documentation only — never commit secrets.
# Copy to `.env` and replace every change-me value before demo or sovereign use.

# --- Profile (server-only) ---
# development | demo | sovereign
VERITY_PROFILE=development
# Alias accepted by Core:
# VERITY_DEPLOYMENT_PROFILE=development

# --- Postgres (server-only, secret) ---
# Compose maps host 5433 -> container 5432. Direct local Postgres often uses 5432.
DATABASE_URL=postgres://verityos:verityos@127.0.0.1:5432/verityos_audit

# Persistent Knowledge blobs (server-only). Mount this to durable storage.
VERITY_DATA_DIR=./data

# Audit Kernel (server-only, not secret)
AUDIT_KERNEL_VERSION=0.2.0
AUDIT_MERKLE_INTERVAL=10

# --- Core API (server-only) ---
PORT=8080
CORS_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
TRUST_PROXY=false
# Required length >= 32 outside development. Never the development default.
SESSION_SECRET=change-me-to-a-32-byte-or-longer-value

# Rate limiting (in-process). Set 0 to disable, 1 to force-on (including under Vitest).
# VERITY_RATE_LIMIT=1

# Demo reset fail-safe. Required together with VERITY_PROFILE=demo|development for pnpm demo:reset.
# VERITY_DEMO_RESET=1

# Explicit mock embeddings are required outside development. Mock is implied only for development.
VERITY_EMBEDDING_PROVIDER=mock
# Local OpenAI-compatible embeddings (sovereign / private):
# VERITY_EMBEDDING_PROVIDER=openai-compatible
# VERITY_EMBEDDING_URL=http://127.0.0.1:11434/v1/embeddings
# VERITY_EMBEDDING_MODEL=nomic-embed-text
# VERITY_EMBEDDING_DIMENSIONS=768
# VERITY_EMBEDDING_API_KEY=
# VERITY_ALLOW_MOCK=1

# Model provider keys — server-only. Leave unset for mock routing.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=

# Nova (server-only)
CORE_API_URL=http://127.0.0.1:8080
NOVA_INTERNAL_URL=http://127.0.0.1:8090
# NOVA_SERVICE_TOKEN=
# NOVA_ORGANIZATION_ID=
# NOVA_SYSTEM_ACTOR_ID=
# NOVA_INTERNAL_TOKEN=
# NOVA_DEV_MODE=1
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_CONTENT_CHANNEL=
# CRON_SECRET=

# Shell. Browser talks to Shell; Shell proxies /v1 to Core.
# CORE_API_URL is server-side for the Shell proxy (default http://127.0.0.1:8080).
# No secret may be NEXT_PUBLIC_*.
# NEXT_PUBLIC_VERITY_ENV=demo

# Connector Gateway — Core only. Never give these to Nova or the browser.
META_GRAPH_BASE=http://127.0.0.1:8099
# META_PAGE_ACCESS_TOKEN=
# META_API_VERSION=v23.0
# META_MOCK_HOST=127.0.0.1
# META_MOCK_PORT=8099

# Optional demo user overrides (server-only). If unset, development uses documented demo passwords;
# demo profile generates one-time passwords and prints them once.
# DEMO_DIRECTOR_EMAIL=director@verity-demo.local
# DEMO_OFFICER_EMAIL=communications@verity-demo.local
# DEMO_ANALYST_EMAIL=analyst@verity-demo.local
# DEMO_DIRECTOR_PASSWORD=
# DEMO_OFFICER_PASSWORD=
# DEMO_ANALYST_PASSWORD=
