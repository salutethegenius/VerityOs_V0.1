# VerityOS local development. Names and documentation only — never commit secrets.

# Postgres (Compose maps host 5433 to avoid clashing with a local 5432)
DATABASE_URL=postgres://verityos:verityos@localhost:5433/verityos_audit

# Persistent document/blob root (Knowledge). Mount this to durable storage.
VERITY_DATA_DIR=./data

# Audit Kernel
AUDIT_KERNEL_VERSION=0.2.0
AUDIT_MERKLE_INTERVAL=10

# Core API
PORT=8080
CORS_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_SECRET=change-me-in-deployment

# Embedding provider for Knowledge. `mock` is the CI/default (hashed 768-d vectors, not semantic).
VERITY_EMBEDDING_PROVIDER=mock
# Local OpenAI-compatible embeddings endpoint on Hummingbird (no external API required):
# VERITY_EMBEDDING_PROVIDER=openai-compatible
# VERITY_EMBEDDING_URL=http://127.0.0.1:11434/v1/embeddings
# VERITY_EMBEDDING_MODEL=nomic-embed-text
# VERITY_EMBEDDING_DIMENSIONS=768
# VERITY_EMBEDDING_API_KEY=

# Model provider keys — set in the live environment only. Leave unset for mock routing.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=

# Nova runtime (non-production). All of these are required for create_runtime_app().
# uvicorn verityos_nova.app.main:create_runtime_app --factory --host 0.0.0.0 --port 8090
CORE_API_URL=http://127.0.0.1:8080
# NOVA_SERVICE_TOKEN=
# NOVA_ORGANIZATION_ID=
# NOVA_SYSTEM_ACTOR_ID=
# NOVA_INTERNAL_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_CONTENT_CHANNEL=
# CRON_SECRET=
