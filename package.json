{
  "name": "verityos",
  "version": "0.1.0-rc1",
  "private": true,
  "description": "VerityOS — governed, grounded, auditable AI operating environment",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "db:migrate": "node-pg-migrate up -m db/migrations",
    "db:migrate:down": "node-pg-migrate down -m db/migrations",
    "db:migrate:create": "node-pg-migrate create -m db/migrations",
    "db:status": "node scripts/db-status.mjs",
    "test:python": "python3 -m pytest apps/nova apps/knowledge packages/sdk-python",
    "lint:python": "python3 -m ruff check apps/nova apps/knowledge packages/sdk-python",
    "seed:dev": "pnpm --filter @verityos/core-api seed:dev",
    "seed:demo": "pnpm --filter @verityos/core-api seed:demo",
    "demo:reset": "node -e \"if(!['demo','development'].includes((process.env.VERITY_PROFILE||process.env.VERITY_DEPLOYMENT_PROFILE||'').toLowerCase())){console.error('demo:reset requires VERITY_PROFILE=demo or development');process.exit(1)}\" && VERITY_DEMO_RESET=1 pnpm seed:demo",
    "demo:check": "node scripts/demo-check.mjs",
    "release:check": "node scripts/release-check.mjs",
    "secret:scan": "node scripts/secret-scan.mjs && node scripts/secret-scan.mjs --self-test",
    "deps:scan": "node scripts/dependency-scan.mjs",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "dev:core": "pnpm --filter @verityos/core-api start",
    "dev:shell": "pnpm --filter @verityos/shell dev",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.15.0",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.13.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
